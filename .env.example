# Copy to .env and fill in. .env is gitignored — never committed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HF_TOKEN=

# Summary backend (default: gemini). Free Gemini API key, no credit card:
#   1. Open https://aistudio.google.com/apikey
#   2. Sign in with any Google account and click "Create API key"
#   3. Paste it below. Free keys get rate-limited (429) when busy — meetrec
#      retries with backoff automatically and falls back to Ollama/Anthropic.
GEMINI_API_KEY=

# Only if summary.backend = anthropic:
ANTHROPIC_API_KEY=
